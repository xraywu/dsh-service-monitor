# ── 依赖 ────────────────────────────────────────────────────────────────────
# 这个包是被 DSH profile 以 link/junction 方式安装的，仓库里不该出现
# node_modules；clone 下来直接 `plugin_manager install_bundle` 即可。
node_modules/
.pnpm-store/

# ── 本地临时物 ──────────────────────────────────────────────────────────────
# 调试时用来放反编译/探测脚本的目录，不属于插件本体。
_recon/
_probe/
.tmp-read/
*.tmp
*.bak

# ── 密钥与运行时状态 ────────────────────────────────────────────────────────
# API Key 正常存在 DSH 凭据库或 $DSH_HOME 下，任何情况下都不进仓库。
.env
.env.*
storages/
state.json

# ── 日志 ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ── 编辑器 / 系统 ───────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
